function(hotbox_prepare_dawn output)
    find_package(Git REQUIRED)
    set(submodule "${PROJECT_SOURCE_DIR}/vendor/dawn")
    set(pin_file "${PROJECT_SOURCE_DIR}/vendor/dawn-revision")
    set(patch "${PROJECT_SOURCE_DIR}/scripts/patches/dawn-version-file.patch")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pin_file}" "${patch}")

    file(READ "${pin_file}" pin)
    string(STRIP "${pin}" pin)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${submodule}" rev-parse HEAD
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT revision STREQUAL pin)
        message(FATAL_ERROR "Dawn must be at ${pin}. Run git submodule update --init -- vendor/dawn.")
    endif()

    file(SHA256 "${patch}" patch_hash)
    set(stamp "${pin}:${patch_hash}")
    set(root "${CMAKE_CURRENT_BINARY_DIR}/dawn-source")
    set(source "${root}/dawn")
    set(previous "")
    if(EXISTS "${root}/ready")
        file(READ "${root}/ready" previous)
    endif()
    if(NOT previous STREQUAL stamp OR NOT EXISTS "${source}/CMakeLists.txt")
        file(REMOVE_RECURSE "${root}")
        file(MAKE_DIRECTORY "${source}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${submodule}" archive
            --format=tar "--output=${root}/source.tar" "${pin}" COMMAND_ERROR_IS_FATAL ANY)
        file(ARCHIVE_EXTRACT INPUT "${root}/source.tar" DESTINATION "${source}")
        file(REMOVE "${root}/source.tar")
        file(WRITE "${root}/dawn-revision" "${pin}")
        # Explicitly isolate both Git metadata and the work tree used by git apply.
        execute_process(COMMAND "${GIT_EXECUTABLE}" init -q "${source}"
            COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" apply "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
        file(REMOVE_RECURSE "${source}/.git")
        file(WRITE "${root}/ready" "${stamp}")
    endif()
    # Earlier builds cached Dawn's default paths inside the checkout.
    get_cmake_property(dawn_cache_variables CACHE_VARIABLES)
    foreach(name IN LISTS dawn_cache_variables)
        if(name MATCHES "^DAWN_.*_DIR$")
            get_property(value CACHE "${name}" PROPERTY VALUE)
            cmake_path(IS_PREFIX submodule "${value}" NORMALIZE old_default)
            if(old_default)
                unset("${name}" CACHE)
            endif()
        endif()
    endforeach()
    set(${output} "${source}" PARENT_SCOPE)
endfunction()
