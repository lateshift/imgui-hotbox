hotbox_require_vendor(glfw/CMakeLists.txt)
hotbox_require_vendor(dawn/include/webgpu/webgpu_glfw.h)
hotbox_require_vendor(imgui/backends/imgui_impl_wgpu.cpp)
hotbox_require_vendor(stb_image_write/stb_image_write.h)

if(APPLE)
    enable_language(OBJC OBJCXX)
endif()
set(GLFW_BUILD_DOCS OFF)
set(GLFW_BUILD_EXAMPLES OFF)
set(GLFW_BUILD_TESTS OFF)
set(GLFW_INSTALL OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    # Dawn needs Xlib’s XCB interop header for its Vulkan X11 surface.
    find_package(X11 REQUIRED COMPONENTS X11_xcb)
    # Support both GLFW platforms in the Linux harness.
    set(GLFW_BUILD_X11 ON)
    set(GLFW_BUILD_WAYLAND ON)
endif()
if(NOT TARGET glfw)
    add_subdirectory(vendor/glfw EXCLUDE_FROM_ALL)
endif()

if(HOTBOX_DAWN_PREBUILT_DIR)
    find_package(Threads REQUIRED)
    find_package(Dawn CONFIG REQUIRED PATHS "${HOTBOX_DAWN_PREBUILT_DIR}" NO_DEFAULT_PATH)
    # Dawn's install exports WebGPU, but its GLFW surface utility is source-only.
    add_library(hotbox_dawn_glfw STATIC vendor/dawn/src/dawn/glfw/utils.cpp)
    target_include_directories(hotbox_dawn_glfw PUBLIC vendor/dawn/include PRIVATE vendor/dawn)
    target_compile_definitions(hotbox_dawn_glfw PRIVATE GLFW_INCLUDE_NONE WGPU_GLFW_IMPLEMENTATION)
    target_link_libraries(hotbox_dawn_glfw PUBLIC dawn::webgpu_dawn PRIVATE glfw)
    if(APPLE)
        target_sources(hotbox_dawn_glfw PRIVATE vendor/dawn/src/dawn/glfw/utils_metal.mm)
        target_compile_definitions(hotbox_dawn_glfw PRIVATE DAWN_ENABLE_BACKEND_METAL)
        target_link_libraries(hotbox_dawn_glfw PRIVATE "-framework Metal" "-framework QuartzCore")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_link_libraries(hotbox_dawn_glfw PRIVATE X11::X11)
        target_compile_definitions(hotbox_dawn_glfw PRIVATE DAWN_USE_X11 DAWN_USE_WAYLAND)
    endif()
    set(hotbox_dawn_glfw hotbox_dawn_glfw)
else()
    include(cmake/DawnSource.cmake)
    hotbox_prepare_dawn(hotbox_dawn_source)
    set(BUILD_SHARED_LIBS OFF)
    set(DAWN_FETCH_DEPENDENCIES ON CACHE BOOL "Fetch Dawn's pinned transitive sources")
    # This Dawn pin spells monolithic ON as a choice of STATIC or SHARED.
    set(DAWN_BUILD_MONOLITHIC_LIBRARY STATIC CACHE STRING "Build the monolithic Dawn library")
    set(DAWN_ENABLE_INSTALL ON CACHE BOOL "Make this Dawn build reusable as a prebuilt prefix")
    set(DAWN_USE_GLFW ON)
    set(DAWN_GLFW_DIR "${PROJECT_SOURCE_DIR}/vendor/glfw")
    set(DAWN_BUILD_SAMPLES OFF)
    set(DAWN_BUILD_TESTS OFF)
    set(DAWN_BUILD_BENCHMARKS OFF)
    set(DAWN_BUILD_PROTOBUF OFF)
    set(DAWN_ENABLE_NULL OFF)
    set(DAWN_ENABLE_WEBGPU_ON_WEBGPU OFF)
    set(DAWN_ENABLE_DESKTOP_GL OFF)
    set(DAWN_ENABLE_OPENGLES OFF)
    set(DAWN_ENABLE_D3D11 OFF)
    set(DAWN_ENABLE_D3D12 OFF)
    set(DAWN_ENABLE_METAL OFF)
    if(WIN32)
        set(DAWN_ENABLE_D3D12 ON)
    elseif(APPLE)
        set(DAWN_ENABLE_METAL ON)
    endif()
    set(DAWN_ENABLE_VULKAN OFF)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        set(DAWN_ENABLE_VULKAN ON)
    endif()
    set(TINT_BUILD_TESTS OFF)
    set(TINT_BUILD_CMD_TOOLS OFF)
    set(TINT_BUILD_GLSL_VALIDATOR OFF)
    set(TINT_BUILD_IR_BINARY OFF)
    function(hotbox_add_dawn)
        if(APPLE)
            # Keep line tables without compiling full Dawn/Tint debug type information.
            set(CMAKE_CXX_FLAGS_DEBUG "${CMAKE_CXX_FLAGS_DEBUG} -gline-tables-only")
            set(CMAKE_OBJCXX_FLAGS_DEBUG "${CMAKE_OBJCXX_FLAGS_DEBUG} -gline-tables-only")
        endif()
        add_subdirectory("${hotbox_dawn_source}" "${CMAKE_CURRENT_BINARY_DIR}/vendor/dawn" EXCLUDE_FROM_ALL)
    endfunction()
    hotbox_add_dawn()
    set(hotbox_dawn_glfw webgpu_glfw)
endif()

if(APPLE)
    # The backend implements its multi-viewport Metal surface in this translation unit.
    set_source_files_properties(vendor/imgui/backends/imgui_impl_wgpu.cpp PROPERTIES LANGUAGE OBJCXX)
endif()
add_library(hotbox_imgui_backends STATIC
    vendor/imgui/backends/imgui_impl_glfw.cpp vendor/imgui/backends/imgui_impl_wgpu.cpp)
target_include_directories(hotbox_imgui_backends SYSTEM PUBLIC vendor/imgui/backends)
target_compile_definitions(hotbox_imgui_backends PUBLIC IMGUI_IMPL_WEBGPU_BACKEND_DAWN GLFW_INCLUDE_NONE)
target_link_libraries(hotbox_imgui_backends PUBLIC ${hotbox_imgui} glfw dawn::webgpu_dawn)

add_executable(hotbox_harness harness/main.cpp harness/demo_commands.cpp harness/wgpu_context.cpp harness/screenshot.cpp harness/tour.cpp
    vendor/imgui/imgui_demo.cpp)
target_include_directories(hotbox_harness SYSTEM PRIVATE vendor/stb_image_write vendor/lucide)
target_compile_definitions(hotbox_harness PRIVATE HOTBOX_HARNESS_FONT_DIR="${PROJECT_SOURCE_DIR}/vendor"
    HOTBOX_HARNESS_ICON_DIR="${PROJECT_SOURCE_DIR}/harness/icons")
target_link_libraries(hotbox_harness PRIVATE hotbox::hotbox hotbox_imgui_backends
    ${hotbox_dawn_glfw} spdlog::spdlog)
if(MSVC)
    target_compile_options(hotbox_harness PRIVATE /utf-8)
endif()
hotbox_instrument(hotbox_harness)
